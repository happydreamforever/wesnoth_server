# Copy with .\dev.ps1 configure. Edit this computer's paths and reachable LAN IP.
# Never commit .env. Existing databases, passwords and private keys stay in the runtime.
WESNOTH_ENV_FORMAT=1
WESNOTH_PROJECT=server
WESNOTH_SERVER_IP=192.168.1.10

# Relative paths are relative to this repository; ${PROJECT_ROOT} is also supported.
# %LOCALAPPDATA%, %USERPROFILE%, %ProgramFiles%, and ${WESNOTH_...} references expand as data.
WESNOTH_PYTHON_PATH=%LOCALAPPDATA%/Programs/Python/Python312/python.exe
WESNOTH_MSYS_ROOT=../msys64
WESNOTH_CMAKE_PATH=%ProgramFiles%/CMake/bin/cmake.exe
WESNOTH_OPENSSL_PATH=${WESNOTH_MSYS_ROOT}/mingw64/bin/openssl.exe
WESNOTH_GAME_DATA_ROOT=../gamedata-1.19.26

# Generated installation paths. Keep these separate from the game runtime.
WESNOTH_SERVICE_ENV_ROOT=build/alliance-venv-py312
WESNOTH_MONGODB_ROOT=build/alliance-mongodb
WESNOTH_DEPENDENCY_CACHE=build/alliance-dependencies

# Local MongoDB only. These settings are frozen into a newly initialized runtime.
# An existing runtime must match; changing .env never rewrites its replica set or credentials.
WESNOTH_MONGO_HOST=127.0.0.1
WESNOTH_MONGO_PORT=27018
WESNOTH_MONGO_DATABASE=wesnoth_game
WESNOTH_MONGO_REPLICA_SET=wesnoth-rs
WESNOTH_RUNTIME_ROOT=%LOCALAPPDATA%/WesnothAlliance/runtime-v3

# Use a new empty identity directory for a different server IP. Existing keys are never replaced.
# Point the client's WESNOTH_PUBLIC_PROFILE_PATH to this directory's public-profile.json.
WESNOTH_IDENTITY_ROOT=runtime/alliance-transport
WESNOTH_WORLD_WORKERS=1
